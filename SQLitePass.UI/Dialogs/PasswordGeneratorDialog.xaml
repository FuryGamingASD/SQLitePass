<Window x:Class="SQLitePass.UI.Dialogs.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="Generatore Password - SQLitePass" Height="480" Width="500"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview & Entropy -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Password Generata" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtGeneratedPassword" IsReadOnly="True" FontSize="16" FontWeight="SemiBold"
                             FontFamily="Consolas" Padding="8,6"/>
                    <Button Grid.Column="1" Content="↻ Nuova" Click="BtnRegenerate_Click" Margin="8,0,0,0" Padding="14,6"
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Medium"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Entropia:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbEntropy" Grid.Column="1" Height="8" Margin="10,0" Maximum="128" Value="75"
                                 Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                    <TextBlock x:Name="TxtEntropy" Grid.Column="2" Text="75.0 bits" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Length slider -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lunghezza:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Slider x:Name="SliderLength" Grid.Column="1" Minimum="6" Maximum="64" Value="20"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderLength_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderLength}" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Options Checkboxes -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Set di Caratteri" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="ChkUpper" Content="Maiuscole (A-Z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                        <CheckBox x:Name="ChkLower" Content="Minuscole (a-z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                        <CheckBox x:Name="ChkDigits" Content="Cifre (0-9)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkSpecial" Content="Simboli (!@#$...)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                        <CheckBox x:Name="ChkBrackets" Content="Parentesi ()[]{}&lt;&gt;" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                        <CheckBox x:Name="ChkExcludeLookAlike" Content="Escludi ambigui (Il1O0)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,4"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copia negli Appunti" Click="BtnCopy_Click" Padding="16,8" Margin="0,0,10,0"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand" FontWeight="Medium"/>
            <Button Content="Usa Questa" Click="BtnAccept_Click" Padding="20,8" Margin="0,0,10,0"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Annulla" Click="BtnCancel_Click" Padding="14,8"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
