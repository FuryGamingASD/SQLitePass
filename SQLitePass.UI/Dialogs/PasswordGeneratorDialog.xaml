<Window x:Class="SQLitePass.UI.Dialogs.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="Password Generator" Height="460" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview & Entropy -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Generated Password" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtGeneratedPassword" IsReadOnly="True" FontSize="15" FontWeight="SemiBold"
                             FontFamily="Consolas" Padding="8,6" Background="#F9FAFB" BorderBrush="#E5E7EB"/>
                    <Button Grid.Column="1" Content="↻ New" Click="BtnRegenerate_Click" Margin="8,0,0,0" Padding="12,6"
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Medium"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Entropy:" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbEntropy" Grid.Column="1" Height="8" Margin="10,0" Maximum="128" Value="75"
                                 Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                    <TextBlock x:Name="TxtEntropy" Grid.Column="2" Text="75.0 bits" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Length slider -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Length:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="SliderLength" Grid.Column="1" Minimum="6" Maximum="64" Value="20"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderLength_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderLength}" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Options Checkboxes -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Character Sets" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="ChkUpper" Content="Uppercase (A-Z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                        <CheckBox x:Name="ChkLower" Content="Lowercase (a-z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                        <CheckBox x:Name="ChkDigits" Content="Digits (0-9)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkSpecial" Content="Special (!@#$...)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                        <CheckBox x:Name="ChkBrackets" Content="Brackets ()[]{}&lt;&gt;" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                        <CheckBox x:Name="ChkExcludeLookAlike" Content="Exclude Look-alikes (Il1O0)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,3"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy to Clipboard" Click="BtnCopy_Click" Padding="14,8" Margin="0,0,10,0"
                    Background="#E5E7EB" Foreground="#1F2937" BorderThickness="0" Cursor="Hand" FontWeight="Medium"/>
            <Button Content="Accept" Click="BtnAccept_Click" Padding="18,8" Margin="0,0,10,0"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Cancel" Click="BtnCancel_Click" Padding="14,8"
                    Background="#E5E7EB" Foreground="#4B5563" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
