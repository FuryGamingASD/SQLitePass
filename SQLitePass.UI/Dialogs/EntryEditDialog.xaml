<Window x:Class="SQLitePass.UI.Dialogs.EntryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="Edit Entry" Height="580" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="White" BorderBrush="#D1D5DB" Padding="12">
            <!-- GENERAL TAB -->
            <TabItem Header="Entry">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtTitle" Grid.Row="0" Grid.Column="1" Padding="6,4" Margin="0,4"/>

                        <!-- User name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="User name:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtUserName" Grid.Row="1" Grid.Column="1" Padding="6,4" Margin="0,4"/>

                        <!-- Password -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Normal PasswordBox / TextBox for show/hide -->
                            <TextBox x:Name="TxtPasswordPlain" Padding="6,4" Visibility="Collapsed" TextChanged="TxtPassword_Changed"/>
                            <PasswordBox x:Name="TxtPasswordMasked" Padding="6,4" PasswordChanged="TxtPasswordMasked_PasswordChanged"/>
                            
                            <Button x:Name="BtnToggleVisibility" Grid.Column="1" Content="👁" Click="BtnToggleVisibility_Click"
                                    Width="30" Margin="4,0,0,0" ToolTip="Show/Hide Password" Background="#E5E7EB" BorderThickness="0"/>
                            <Button Grid.Column="2" Content="⚡ Generate" Click="BtnGenerate_Click"
                                    Margin="4,0,0,0" Padding="8,4" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Medium"/>
                        </Grid>

                        <!-- Password Quality bar -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Quality:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,2"/>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="PbQuality" Height="6" Maximum="128" Value="0"
                                         Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                            <TextBlock x:Name="TxtQualityScore" Grid.Column="1" Text="0 bits" Foreground="#6B7280" FontSize="11" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- URL -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="URL:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtUrl" Grid.Row="4" Grid.Column="1" Padding="6,4" Margin="0,4"/>

                        <!-- Expiration -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Expires:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkExpires" Content="Enable expiry date" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkExpires_Changed" Unchecked="ChkExpires_Changed"/>
                            <DatePicker x:Name="DpExpiry" IsEnabled="False" Width="150"/>
                        </StackPanel>

                        <!-- Tags -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Tags:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtTags" Grid.Row="6" Grid.Column="1" Padding="6,4" Margin="0,4"/>

                        <!-- Notes -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Notes:" VerticalAlignment="Top" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtNotes" Grid.Row="7" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="110" Padding="6,4" Margin="0,4" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ADVANCED / CUSTOM FIELDS TAB -->
            <TabItem Header="Advanced">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Custom String Fields" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgCustomFields" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field Name" Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Protected" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add Field" Click="BtnAddField_Click" Padding="10,5" Margin="0,0,8,0" Background="#E5E7EB" BorderThickness="0"/>
                        <Button Content="- Delete Field" Click="BtnDeleteField_Click" Padding="10,5" Background="#E5E7EB" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- AUTO-TYPE TAB -->
            <TabItem Header="Auto-Type">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkAutoTypeEnabled" Content="Enable Auto-Type for this entry" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Keystroke Sequence:" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtAutoTypeSeq" Padding="8,6" Text="{}{USERNAME}{TAB}{PASSWORD}{ENTER}" FontFamily="Consolas"/>
                    <TextBlock Text="Placeholder helpers:" Margin="0,14,0,6" Foreground="#6B7280"/>
                    <WrapPanel>
                        <Button Content="{}{USERNAME}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{PASSWORD}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{TITLE}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{URL}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{TAB}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{ENTER}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{SPACE}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                        <Button Content="{}{DELAY 500}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="6,4"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ATTACHMENTS TAB -->
            <TabItem Header="Attachments">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstAttachments" DisplayMemberPath="FileName"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Attach File..." Click="BtnAttachFile_Click" Padding="10,5" Margin="0,0,8,0" Background="#E5E7EB" BorderThickness="0"/>
                        <Button Content="Save Attachment..." Click="BtnSaveAttachment_Click" Padding="10,5" Margin="0,0,8,0" Background="#E5E7EB" BorderThickness="0"/>
                        <Button Content="Remove" Click="BtnRemoveAttachment_Click" Padding="10,5" Background="#E5E7EB" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- HISTORY TAB -->
            <TabItem Header="History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Revision Date" Binding="{Binding SavedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Restore Selected Revision" Click="BtnRestoreHistory_Click"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" Background="#E5E7EB" BorderThickness="0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM BUTTONS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save Entry" Click="BtnSave_Click" IsDefault="True" Padding="18,8" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True" Padding="14,8"
                    Background="#E5E7EB" Foreground="#4B5563" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
