<Window x:Class="SQLitePass.UI.Dialogs.EntryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SQLitePass.UI.Controls"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="{DynamicResource EntryEditTitle}" Height="600" Width="660"
        Icon="/SQLitePass;component/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:ProtectedFieldConverter x:Key="ProtectedFieldConverter"/>
        <conv:LocalDateTimeConverter x:Key="LocalDateTimeConverter"/>
        <conv:TextPreviewConverter x:Key="TextPreviewConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="TabItem" BasedOn="{StaticResource AppTabItem}">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="EntryTabs" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" Padding="14">
            <!-- GENERAL TAB -->
            <TabItem Header="{DynamicResource TabCredentials}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LblTitle}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtTitle" AutomationProperties.Name="{DynamicResource LblTitle}" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                        <!-- User name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LblUserName}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtUserName" AutomationProperties.Name="{DynamicResource LblUserName}" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                        <!-- Password -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LblPassword}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPasswordPlain" AutomationProperties.Name="{DynamicResource LblPassword}" Visibility="Collapsed" IsUndoEnabled="False" TextChanged="TxtPassword_Changed"/>
                            <PasswordBox x:Name="TxtPasswordMasked" AutomationProperties.Name="{DynamicResource LblPassword}" PasswordChanged="TxtPasswordMasked_PasswordChanged"/>
                            
                            <Button x:Name="BtnToggleVisibility" Grid.Column="1"  Click="BtnToggleVisibility_Click"
                                    Width="36" Padding="4" Margin="6,0,0,0" ToolTip="{DynamicResource ShowPassword}" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="{DynamicResource ShowPassword}"><ui:AppIcon Kind="Eye"/></Button>
                            <Button Grid.Column="2" Content="{DynamicResource BtnGenerate}" Click="BtnGenerate_Click"
                                    Margin="6,0,0,0" Padding="12,5" Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>

                        <!-- Password Quality bar -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LblQuality}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,2"/>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="PbQuality" Height="6" Maximum="100" Value="0"
                                         Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                            <TextBlock x:Name="TxtQualityScore" Grid.Column="1" Text="0/100" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- URL -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LblUrl}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtUrl" AutomationProperties.Name="{DynamicResource LblUrl}" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

                        <!-- Expiration -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource LblExpiration}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkExpires" Content="{DynamicResource ChkEnableExpiry}" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkExpires_Changed" Unchecked="ChkExpires_Changed"/>
                            <DatePicker x:Name="DpExpiry" AutomationProperties.Name="{DynamicResource LblExpiration}" IsEnabled="False" Width="160"/>
                        </StackPanel>

                        <!-- Tags -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource LblTags}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtTags" AutomationProperties.Name="{DynamicResource LblTags}" Grid.Row="6" Grid.Column="1" Margin="0,4"/>

                        <!-- Notes -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource LblNotes}" VerticalAlignment="Top" FontWeight="Medium" Margin="0,6"/>
                        <TextBox x:Name="TxtNotes" AutomationProperties.Name="{DynamicResource LblNotes}" Grid.Row="7" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="110" Margin="0,4" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ADVANCED / CUSTOM FIELDS TAB -->
            <TabItem Header="{DynamicResource CustomFieldsTab}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource CustomFieldsHeading}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgCustomFields" AutomationProperties.Name="{DynamicResource CustomFieldsTab}" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              Background="{DynamicResource InputBg}" RowBackground="{DynamicResource InputBg}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource FieldName}" Binding="{Binding Key}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource FieldValue}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource ProtectedFieldConverter}"><Binding Path="Value"/><Binding Path="IsProtected"/></MultiBinding></TextBlock.Text></TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="{DynamicResource FieldProtected}" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource AddField}" Click="BtnAddField_Click" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{DynamicResource Edit}" Click="BtnEditField_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource RemoveField}" Click="BtnDeleteField_Click" Padding="12,6" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- AUTO-TYPE TAB -->
            <TabItem Header="{DynamicResource AutoTypeTab}">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkAutoTypeEnabled" Content="{DynamicResource AutoTypeEnabled}" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource AutoTypeSequence}" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtAutoTypeSeq" AutomationProperties.Name="{DynamicResource AutoTypeSequence}" Padding="8,6" Text="{}{USERNAME}{TAB}{PASSWORD}{ENTER}" FontFamily="Consolas"/>
                    <TextBlock Text="{DynamicResource AutoTypePlaceholders}" Margin="0,14,0,8" Foreground="{DynamicResource TextMuted}"/>
                    <WrapPanel>
                        <Button Content="{}{USERNAME}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{PASSWORD}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{TITLE}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{URL}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{TAB}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{ENTER}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{SPACE}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{}{DELAY 500}" Click="BtnInsertPlaceholder_Click" Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ATTACHMENTS TAB -->
            <TabItem Header="{DynamicResource AttachmentsTab}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstAttachments" AutomationProperties.Name="{DynamicResource AttachmentsTab}"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding FileName, Converter={StaticResource TextPreviewConverter}}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Data.LongLength, StringFormat={}{0:N0} B}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource AddAttachment}" Click="BtnAttachFile_Click" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{DynamicResource SaveAttachment}" Click="BtnSaveAttachment_Click" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="{DynamicResource Delete}" Click="BtnRemoveAttachment_Click" Padding="12,6" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource DangerText}" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- HISTORY TAB -->
            <TabItem Header="{DynamicResource TabHistory}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgHistory" AutomationProperties.Name="{DynamicResource TabHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                              HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              Background="{DynamicResource InputBg}" RowBackground="{DynamicResource InputBg}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource HistoryDate}" Binding="{Binding SavedAt, Converter={StaticResource LocalDateTimeConverter}}" Width="160"/>
                            <DataGridTextColumn Header="{DynamicResource ColTitle}" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource ColUserName}" Binding="{Binding UserName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource HistoryRestoreTitle}" Click="BtnRestoreHistory_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="{DynamicResource ClearHistory}" Click="BtnClearHistory_Click" Margin="10,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM BUTTONS -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
            <Button x:Name="BtnSaveEntry" Content="{DynamicResource Save}" Click="BtnSave_Click" IsDefault="True" Padding="20,9" Margin="0,0,10,0"
                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="{DynamicResource Cancel}" Click="BtnCancel_Click" IsCancel="True" Padding="16,9"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtEntryValidation" TextWrapping="Wrap" Foreground="{DynamicResource DangerText}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="TxtEditState" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        </DockPanel>
    </Grid>
</Window>
