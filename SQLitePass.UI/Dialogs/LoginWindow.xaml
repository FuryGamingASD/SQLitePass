<Window x:Class="SQLitePass.UI.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoginTitle}" Height="520" Width="530"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Custom Template for Editable ComboBox to guarantee readable text in both Dark and Light themes -->
        <ControlTemplate x:Key="ModernEditableComboBoxTemplate" TargetType="ComboBox">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <!-- Editable TextBox part -->
                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                             Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource AccentColor}" BorderThickness="0"
                             Padding="8,6" VerticalContentAlignment="Center" FontSize="12"/>
                    <!-- Dropdown Toggle Button -->
                    <ToggleButton Grid.Column="1" Background="Transparent" BorderThickness="0"
                                  Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock Text="▼" FontSize="9" Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <!-- Popup dropdown items -->
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom">
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="200" Padding="4" Margin="0,2,0,0">
                            <ScrollViewer SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Circular"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Resources/app_icon.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SQLitePass" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource LoginHeaderSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="🌓" Click="BtnToggleTheme_Click" ToolTip="Toggle Light / Dark Theme"
                        Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" VerticalAlignment="Center" Padding="6"/>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel>
                <!-- File Database -->
                <TextBlock Text="{DynamicResource LoginDatabaseFile}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Editable ComboBox with guaranteed readable text -->
                    <ComboBox x:Name="CmbRecentVaults" IsEditable="True" Template="{StaticResource ModernEditableComboBoxTemplate}"
                              SelectionChanged="CmbRecentVaults_SelectionChanged"/>
                    <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseVault_Click"
                            Margin="8,0,0,0" Padding="14,6" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
                </Grid>

                <!-- Backup status badge -->
                <StackPanel x:Name="PanelBackupStatus" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                    <Border Background="{DynamicResource BadgeSuccessBg}" BorderBrush="{DynamicResource BadgeSuccessBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="TxtBackupFound" Text="{DynamicResource LoginBackupPresent}" Foreground="{DynamicResource BadgeSuccessFg}" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Button Content="{DynamicResource LoginRestoreBackup}" Click="BtnRestoreBackup_Click"
                            Margin="10,0,0,0" Padding="4,2" FontSize="11" Background="Transparent" Foreground="{DynamicResource AccentColor}" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <Separator Margin="0,4,0,16" Background="{DynamicResource BorderColor}"/>

                <!-- Master Password -->
                <TextBlock Text="{DynamicResource LoginMasterPassword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="TxtMasterPassword" Padding="8,7" FontSize="14"/>
                    <TextBox x:Name="TxtMasterPasswordPlain" Visibility="Collapsed" Padding="8,7" FontSize="14"/>
                    <Button x:Name="BtnToggleMasterPwd" Grid.Column="1" Content="👁" Click="BtnToggleMasterPwd_Click"
                            Width="36" Margin="6,0,0,0" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand"/>
                </Grid>

                <!-- Key File -->
                <CheckBox x:Name="ChkUseKeyFile" Content="{DynamicResource LoginUseKeyFile}"
                          Checked="ChkUseKeyFile_Changed" Unchecked="ChkUseKeyFile_Changed"
                          Margin="0,0,0,6"/>
                <Grid x:Name="GridKeyFile" IsEnabled="False" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtKeyFilePath" IsReadOnly="True" Padding="8,6"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"/>
                    <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseKeyFile_Click"
                            Margin="6,0,0,0" Padding="10,4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource Exit}" Click="BtnExit_Click" Padding="16,9" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource LoginNewVault}" Click="BtnCreateVault_Click" Padding="14,9" Margin="0,0,10,0"
                        Background="#0D9488" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="{DynamicResource LoginUnlock}" Click="BtnOpenVault_Click" IsDefault="True" Padding="22,9"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
