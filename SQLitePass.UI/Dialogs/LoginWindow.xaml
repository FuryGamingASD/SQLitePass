<Window x:Class="SQLitePass.UI.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeePass SQLite - Sblocco Vault" Height="520" Width="530"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" Background="#1E293B" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="KeePass SQLite" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Zero-Knowledge Vault • Anti-Corruzione con Dual Backup" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- File Database -->
                <TextBlock Text="File Database del Vault (*.kpd):" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbRecentVaults" IsEditable="True" Padding="8,6" FontSize="12"
                              SelectionChanged="CmbRecentVaults_SelectionChanged"/>
                    <Button Grid.Column="1" Content="Sfoglia..." Click="BtnBrowseVault_Click"
                            Margin="8,0,0,0" Padding="14,6" Background="#F1F5F9" Foreground="#1E293B"
                            BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
                </Grid>

                <!-- Backup status badge -->
                <StackPanel x:Name="PanelBackupStatus" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="TxtBackupFound" Text="✓ File .backup presente e sincronizzato" Foreground="#047857" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Button Content="Ripristina da .backup" Click="BtnRestoreBackup_Click"
                            Margin="8,0,0,0" Padding="6,2" FontSize="11" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <Separator Margin="0,4,0,14" Background="#E2E8F0"/>

                <!-- Master Password -->
                <TextBlock Text="Master Password:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="TxtMasterPassword" Padding="8,7" FontSize="14" BorderBrush="#CBD5E1"/>
                    <TextBox x:Name="TxtMasterPasswordPlain" Visibility="Collapsed" Padding="8,7" FontSize="14" BorderBrush="#CBD5E1"/>
                    <Button x:Name="BtnToggleMasterPwd" Grid.Column="1" Content="👁" Click="BtnToggleMasterPwd_Click"
                            Width="36" Margin="6,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                </Grid>

                <!-- Key File -->
                <CheckBox x:Name="ChkUseKeyFile" Content="Utilizza anche un Key File (.key opzionale)"
                          Checked="ChkUseKeyFile_Changed" Unchecked="ChkUseKeyFile_Changed"
                          Margin="0,0,0,6" Foreground="#475569"/>
                <Grid x:Name="GridKeyFile" IsEnabled="False" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtKeyFilePath" IsReadOnly="True" Padding="6,4" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                    <Button Grid.Column="1" Content="Sfoglia..." Click="BtnBrowseKeyFile_Click"
                            Margin="6,0,0,0" Padding="10,4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Esci" Click="BtnExit_Click" Padding="16,9" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="+ Nuovo Vault..." Click="BtnCreateVault_Click" Padding="14,9" Margin="0,0,10,0"
                        Background="#0D9488" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Sblocca Vault" Click="BtnOpenVault_Click" IsDefault="True" Padding="22,9"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
