<Window x:Class="SQLitePass.UI.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoginTitle}" Height="540" Width="480"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Modern Primary Button Style -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Subtle Action Button -->
        <Style x:Key="ModernSubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discreet Link Button Style -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single Elegant Modal Card (No Nested Box-in-Box) -->
    <Grid Margin="20">
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="16" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Inputs Form -->
                    <RowDefinition Height="Auto"/> <!-- Primary & Secondary Actions -->
                </Grid.RowDefinitions>

                <!-- 1. Header (Brand Icon + Title + Theme Toggle) -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Source="/Resources/app_icon.png" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SQLitePass" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource LoginHeaderSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="🌓" Click="BtnToggleTheme_Click" ToolTip="Toggle Light / Dark Theme"
                            Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" VerticalAlignment="Center" Padding="4"/>
                </Grid>

                <!-- 2. Inputs Form (Identical Width & Cohesive Modern Styling) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- Vault Database File -->
                    <TextBlock Text="{DynamicResource LoginDatabaseFile}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbRecentVaults" IsEditable="True" Height="36"
                                  Template="{StaticResource ModernEditableComboBoxTemplate}"
                                  SelectionChanged="CmbRecentVaults_SelectionChanged"/>
                        <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseVault_Click"
                                Style="{StaticResource ModernSubtleButton}" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Minimal Backup Status Dot -->
                    <StackPanel x:Name="PanelBackupStatus" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BadgeSuccessFg}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtBackupFound" Text="{DynamicResource LoginBackupPresent}" Foreground="{DynamicResource BadgeSuccessFg}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Button Content="{DynamicResource LoginRestoreBackup}" Click="BtnRestoreBackup_Click"
                                Style="{StaticResource LinkButton}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Master Password -->
                    <TextBlock Text="{DynamicResource LoginMasterPassword}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtMasterPassword" Height="36"/>
                        <TextBox x:Name="TxtMasterPasswordPlain" Visibility="Collapsed" Height="36"/>
                        <Button x:Name="BtnToggleMasterPwd" Grid.Column="1" Content="👁" Click="BtnToggleMasterPwd_Click"
                                Style="{StaticResource ModernSubtleButton}" Width="38" Margin="8,0,0,0" ToolTip="Show/Hide Password"/>
                    </Grid>

                    <!-- Key File Option -->
                    <CheckBox x:Name="ChkUseKeyFile" Content="{DynamicResource LoginUseKeyFile}"
                              Checked="ChkUseKeyFile_Changed" Unchecked="ChkUseKeyFile_Changed"
                              Margin="0,0,0,8"/>
                    <Grid x:Name="GridKeyFile" IsEnabled="False" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtKeyFilePath" IsReadOnly="True" Height="36"
                                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseKeyFile_Click"
                                Style="{StaticResource ModernSubtleButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- 3. Actions: Full-Width Primary Button + Discreet Secondary Links -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button Content="{DynamicResource LoginUnlock}" Click="BtnOpenVault_Click" IsDefault="True"
                            Style="{StaticResource ModernPrimaryButton}"/>

                    <!-- Secondary Footer Links -->
                    <Grid Margin="0,14,0,0">
                        <Button Content="{DynamicResource LoginNewVault}" Click="BtnCreateVault_Click"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/>
                        <Button Content="{DynamicResource Exit}" Click="BtnExit_Click"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
