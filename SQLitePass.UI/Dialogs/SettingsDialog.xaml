<Window x:Class="SQLitePass.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni - SQLitePass" Height="620" Width="530"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Impostazioni del Programma" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Aspetto & Tema -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🎨 Aspetto e Tema" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkDarkMode" Content="Attiva Tema Scuro (Dark Obsidian Mode)" IsChecked="True" FontWeight="Medium" Margin="0,3"/>
                        <CheckBox x:Name="ChkShowPasswordDefault" Content="Mostra colonna password in chiaro all'apertura (sconsigliato)" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 2. Sicurezza & Blocco -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🔒 Sicurezza e Blocco Automatico" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cancella appunti (clipboard) dopo:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtClipboardSeconds" Text="12" Width="45" TextAlignment="Center" Padding="4,2"/>
                                <TextBlock Text=" secondi" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Blocca vault per inattività dopo:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbAutoLockMinutes" Grid.Column="1" Width="130" Padding="6,3">
                                <ComboBoxItem Content="Disabilitato" Tag="0"/>
                                <ComboBoxItem Content="1 minuto" Tag="1"/>
                                <ComboBoxItem Content="3 minuti" Tag="3"/>
                                <ComboBoxItem Content="5 minuti" Tag="5"/>
                                <ComboBoxItem Content="10 minuti" Tag="10"/>
                                <ComboBoxItem Content="15 minuti" Tag="15"/>
                                <ComboBoxItem Content="30 minuti" Tag="30"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkLockOnMinimize" Content="Blocca automaticamente il vault alla riduzione a icona" Margin="0,3"/>
                        <CheckBox x:Name="ChkLockOnWindowsLock" Content="Blocca il vault al blocco della sessione Windows (Win+L)" IsChecked="True" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 3. Area di Notifica (System Tray) e Finestra -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖥️ Finestra e Area di Notifica (System Tray)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Riduci a icona nell'area di notifica (System Tray)" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="ChkCloseToTray" Content="Il pulsante di chiusura (X) riduce nella tray invece di chiudere l'app" Margin="0,3"/>
                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Mantieni la finestra sempre in primo piano" Margin="0,3"/>
                        <CheckBox x:Name="ChkStartWithWindows" Content="Avvia SQLitePass all'avvio di Windows" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 4. Protezione & Backup Duplicato -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🛡️ Affidabilità e Backup Automatico" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkDualFileBackup" Content="Crea e aggiorna il file .backup duplicato e isolato"
                                  IsChecked="True" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Il file .backup non resta mai aperto durante il lavoro, azzerando qualsiasi rischio di corruzione in caso di crash o riavvio forzato."
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="Cartella backup secondaria opzionale (es. chiavetta USB o disco esterno):" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSecondaryBackupDir" Padding="6,3" FontSize="11" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Sfoglia..." Click="BtnBrowseSecondaryDir_Click"
                                    Margin="6,0,0,0" Padding="10,3" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottoni Azione -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salva Impostazioni" Click="BtnSave_Click" IsDefault="True" Padding="18,8" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Annulla" Click="BtnCancel_Click" IsCancel="True" Padding="14,8"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
