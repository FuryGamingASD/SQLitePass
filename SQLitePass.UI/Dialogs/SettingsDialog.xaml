<Window x:Class="SQLitePass.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Height="640" Width="530"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource SettingsHeading}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Aspetto & Lingua -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsSectionAppearance}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        
                        <!-- Language Selector -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsLanguage}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="150" Padding="6,3">
                                <ComboBoxItem Content="🇮🇹 Italiano" Tag="it"/>
                                <ComboBoxItem Content="🇬🇧 English" Tag="en"/>
                                <ComboBoxItem Content="🇫🇷 Français" Tag="fr"/>
                                <ComboBoxItem Content="🇩🇪 Deutsch" Tag="de"/>
                                <ComboBoxItem Content="🇪🇸 Español" Tag="es"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkDarkMode" Content="{DynamicResource SettingsDarkMode}" IsChecked="True" FontWeight="Medium" Margin="0,3"/>
                        <CheckBox x:Name="ChkShowPasswordDefault" Content="{DynamicResource SettingsShowPasswordDefault}" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 2. Sicurezza & Blocco -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsSectionSecurity}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsClipboardTimeout}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtClipboardSeconds" Text="12" Width="45" TextAlignment="Center" Padding="4,2"/>
                                <TextBlock Text="{DynamicResource SettingsSeconds}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsAutoLockTimeout}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbAutoLockMinutes" Grid.Column="1" Width="130" Padding="6,3">
                                <ComboBoxItem Content="Disabled" Tag="0"/>
                                <ComboBoxItem Content="1 min" Tag="1"/>
                                <ComboBoxItem Content="3 min" Tag="3"/>
                                <ComboBoxItem Content="5 min" Tag="5"/>
                                <ComboBoxItem Content="10 min" Tag="10"/>
                                <ComboBoxItem Content="15 min" Tag="15"/>
                                <ComboBoxItem Content="30 min" Tag="30"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkLockOnMinimize" Content="{DynamicResource SettingsLockOnMinimize}" Margin="0,3"/>
                        <CheckBox x:Name="ChkLockOnWindowsLock" Content="{DynamicResource SettingsLockOnWindowsLock}" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="ChkProtectScreenCapture" Content="{DynamicResource SettingsProtectScreenCapture}" IsChecked="True" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 3. Area di Notifica (System Tray) e Finestra -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsSectionTray}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="{DynamicResource SettingsMinimizeToTray}" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="ChkCloseToTray" Content="{DynamicResource SettingsCloseToTray}" Margin="0,3"/>
                        <CheckBox x:Name="ChkAlwaysOnTop" Content="{DynamicResource SettingsAlwaysOnTop}" Margin="0,3"/>
                        <CheckBox x:Name="ChkStartWithWindows" Content="{DynamicResource SettingsStartWithWindows}" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <!-- 4. Protezione & Backup Duplicato -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsSectionBackup}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkDualFileBackup" Content="{DynamicResource SettingsDualFileBackup}"
                                  IsChecked="True" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource SettingsDualFileDesc}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource SettingsSecondaryDir}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSecondaryBackupDir" Padding="6,3" FontSize="11" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseSecondaryDir_Click"
                                    Margin="6,0,0,0" Padding="10,3" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottoni Azione -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Save}" Click="BtnSave_Click" IsDefault="True" Padding="18,8" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="{DynamicResource Cancel}" Click="BtnCancel_Click" IsCancel="True" Padding="14,8"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
