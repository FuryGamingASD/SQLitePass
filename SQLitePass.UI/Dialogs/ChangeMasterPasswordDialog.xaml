<Window x:Class="SQLitePass.UI.Dialogs.ChangeMasterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambia Master Password" Height="480" Width="460"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔑 Cambia Master Password del Vault" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="La modifica della master password ricifrerà l'intero database in modo atomico." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- Current Password -->
            <TextBlock Text="Master Password Attuale:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtCurrentPassword" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

            <!-- New Password -->
            <TextBlock Text="Nuova Master Password:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtNewPassword" Padding="8,6" FontSize="13" PasswordChanged="TxtNewPassword_PasswordChanged"/>

            <!-- Quality Bar -->
            <Grid Margin="0,6,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="PbQuality" Height="5" Maximum="128" Value="0" Foreground="#2563EB" Background="{DynamicResource BorderColor}" BorderThickness="0"/>
                <TextBlock x:Name="TxtQualityScore" Grid.Column="1" Text="0 bits" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Confirm New Password -->
            <TextBlock Text="Conferma Nuova Password:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtConfirmPassword" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

            <!-- Optional Key File -->
            <CheckBox x:Name="ChkUseKeyFile" Content="Utilizza anche un File Chiave (Key File)" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Checked="ChkUseKeyFile_Changed" Unchecked="ChkUseKeyFile_Changed" Margin="0,0,0,6"/>
            <Grid x:Name="GridKeyFile" IsEnabled="False" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtKeyFilePath" IsReadOnly="True" Padding="8,5" FontSize="12"/>
                <Button Grid.Column="1" Content="Sfoglia..." Click="BtnBrowseKeyFile_Click" Margin="6,0,0,0" Padding="12,5"
                        Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Full Stealth Mode -->
            <CheckBox x:Name="ChkEncryptUserUrl" Content="Cifra anche Nome Utente e URL (Full Stealth Mode)" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
            <TextBlock Text="Impedisce a chi esamina il file .kpd di leggere quali account o siti web sono memorizzati." FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="20,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Salva Nuova Password" Click="BtnSave_Click" IsDefault="True" Padding="18,8" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Annulla" Click="BtnCancel_Click" IsCancel="True" Padding="14,8"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
