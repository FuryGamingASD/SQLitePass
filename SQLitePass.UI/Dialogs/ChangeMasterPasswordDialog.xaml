<Window x:Class="SQLitePass.UI.Dialogs.ChangeMasterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MasterChangeTitle}" Height="620" Width="520" MinHeight="420" MinWidth="460"
        Icon="/SQLitePass;component/Resources/app_icon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource MasterChangeTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource MasterChangeDescription}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Current Password -->
            <TextBlock Text="{DynamicResource CurrentMasterPassword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtCurrentPassword" AutomationProperties.Name="{DynamicResource CurrentMasterPassword}" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource CurrentKeyFile}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BtnBrowseCurrentKeyFile_Click" Margin="6,0,0,0"/>
                <TextBox x:Name="TxtCurrentKeyFile" IsReadOnly="True" AutomationProperties.Name="{DynamicResource CurrentKeyFile}"/>
            </DockPanel>

            <!-- New Password -->
            <TextBlock Text="{DynamicResource NewMasterPassword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtNewPassword" AutomationProperties.Name="{DynamicResource NewMasterPassword}" Padding="8,6" FontSize="13" PasswordChanged="TxtNewPassword_PasswordChanged"/>

            <!-- Quality Bar -->
            <Grid Margin="0,6,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="PbQuality" Height="5" Maximum="100" Value="0" Foreground="{DynamicResource LinkColor}" Background="{DynamicResource BorderColor}" BorderThickness="0"/>
                <TextBlock x:Name="TxtQualityScore" Grid.Column="1" Text="0/100" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Confirm New Password -->
            <TextBlock Text="{DynamicResource ConfirmMasterPassword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtConfirmPassword" AutomationProperties.Name="{DynamicResource ConfirmMasterPassword}" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

            <!-- Optional Key File -->
            <CheckBox x:Name="ChkUseKeyFile" Content="{DynamicResource UseNewKeyFile}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Checked="ChkUseKeyFile_Changed" Unchecked="ChkUseKeyFile_Changed" Margin="0,0,0,6"/>
            <Grid x:Name="GridKeyFile" IsEnabled="False" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtKeyFilePath" AutomationProperties.Name="{DynamicResource NewKeyFile}" IsReadOnly="True" Padding="8,5" FontSize="12"/>
                <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BtnBrowseKeyFile_Click" Margin="6,0,0,0" Padding="12,5"
                        Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Full Stealth Mode -->
            <CheckBox x:Name="ChkEncryptUserUrl" Content="{DynamicResource EncryptedFieldsInfo}" IsChecked="True" IsEnabled="False" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
            <TextBlock Text="{DynamicResource PreviousKeyBackupInfo}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource SaveNewCredential}" Click="BtnSave_Click" IsDefault="True" Padding="18,8" Margin="0,0,10,0"
                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="{DynamicResource Cancel}" Click="BtnCancel_Click" IsCancel="True" Padding="14,8"
                    Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
