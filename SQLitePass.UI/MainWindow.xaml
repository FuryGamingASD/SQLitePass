<Window x:Class="SQLitePass.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="SQLitePass" Height="720" Width="1080"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>
        <conv:PasswordMaskConverter x:Key="PasswordMaskConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:GroupIconConverter x:Key="GroupIconConverter"/>
        <conv:EntryIconConverter x:Key="EntryIconConverter"/>
        <conv:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
        <conv:CanAutoTypeConverter x:Key="CanAutoTypeConverter"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Tool Button (Clean Icon-Only Toolbar Button) -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Height" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- TreeView Item Style (Modern Bitwarden-style rounded pill) -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" Margin="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Width="14" Height="14">
                                                                <Path x:Name="ExpandPath" Fill="{DynamicResource TextMuted}" Data="M 3 0 L 7 4 L 3 8 Z" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpandPath" Property="Data" Value="M 0 2 L 8 2 L 4 6 Z"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActivePillBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small Preview Action Button -->
        <Style x:Key="PreviewSmallButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENU BAR -->
        <Menu Grid.Row="0" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="6,3">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuAddEntry}" InputGestureText="Ctrl+I" Click="BtnAddEntry_Click"/>
                <MenuItem Header="{DynamicResource MenuAddGroup}" InputGestureText="Ctrl+G" Click="BtnAddGroup_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuLockVault}" InputGestureText="Ctrl+L" Click="BtnLock_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuImportCsv}" Click="MenuImportCsv_Click"/>
                <MenuItem Header="{DynamicResource MenuImportBitwardenJson}" Click="MenuImportBitwardenJson_Click"/>
                <MenuItem Header="{DynamicResource MenuImportBrowserCsv}" Click="MenuImportBrowserCsv_Click"/>
                <MenuItem Header="{DynamicResource MenuExportCsv}" Click="MenuExportCsv_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuSettings}" Click="MenuSettings_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuExit}" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuEdit}">
                <MenuItem Header="{DynamicResource MenuEditEntry}" InputGestureText="Enter" Click="BtnEditEntry_Click"
                          IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource NotNullToBoolConverter}}"/>
                <MenuItem Header="{DynamicResource MenuDuplicateEntry}" Click="BtnDuplicateEntry_Click"
                          IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource NotNullToBoolConverter}}"/>
                <MenuItem Header="{DynamicResource MenuDeleteEntry}" InputGestureText="Del" Click="BtnDeleteEntry_Click"
                          IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource NotNullToBoolConverter}}"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuRenameGroup}" Click="MenuRenameGroup_Click"/>
                <MenuItem Header="{DynamicResource MenuDeleteGroup}" Click="MenuDeleteGroup_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuMoveGroupUp}" InputGestureText="Ctrl+Up" Click="MenuMoveGroupUp_Click"/>
                <MenuItem Header="{DynamicResource MenuMoveGroupDown}" InputGestureText="Ctrl+Down" Click="MenuMoveGroupDown_Click"/>
                <MenuItem Header="{DynamicResource MenuMoveGroupToRoot}" Click="MenuMoveGroupToRoot_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuEmptyTrash}" Click="MenuEmptyTrash_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuView}">
                <MenuItem Header="{DynamicResource MenuToggleTheme}" Click="MenuToggleTheme_Click"/>
                <MenuItem Header="{DynamicResource MenuTogglePasswords}" InputGestureText="Ctrl+H" Click="MenuTogglePasswords_Click"/>
                <MenuItem Header="{DynamicResource MenuRefresh}" InputGestureText="F5" Click="MenuRefresh_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuTools}">
                <MenuItem Header="{DynamicResource MenuPasswordGenerator}" InputGestureText="Ctrl+W" Click="BtnPasswordGenerator_Click"/>
                <MenuItem Header="{DynamicResource MenuAutoType}" InputGestureText="Ctrl+V" Click="BtnAutoType_Click"
                          IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource CanAutoTypeConverter}}"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuClearClipboard}" Click="BtnClearClipboard_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuHelp}">
                <MenuItem Header="{DynamicResource MenuCheckUpdates}" Click="MenuCheckUpdates_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="{DynamicResource MenuAbout}" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- New Entry Button -->
                    <Button Style="{StaticResource PrimaryToolButton}" Click="BtnAddEntry_Click" ToolTip="{DynamicResource TbNewEntry}">
                        <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Click="BtnEditEntry_Click" ToolTip="{DynamicResource TbEdit}"
                            IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource NotNullToBoolConverter}}">
                        <TextBlock Text="✏️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnDeleteEntry_Click" ToolTip="{DynamicResource TbDelete}"
                            IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource NotNullToBoolConverter}}">
                        <TextBlock Text="🗑️" FontSize="13" Foreground="#EF4444" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource ToolButton}" Click="BtnCopyUsername_Click" ToolTip="{DynamicResource TbCopyUser}"
                            IsEnabled="{Binding SelectedItem.UserName, ElementName=DgEntries, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                        <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnCopyPassword_Click" ToolTip="{DynamicResource TbCopyPassword}"
                            IsEnabled="{Binding SelectedItem.Password, ElementName=DgEntries, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                        <TextBlock Text="🔑" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnOpenUrl_Click" ToolTip="{DynamicResource TbOpenUrl}"
                            IsEnabled="{Binding SelectedItem.Url, ElementName=DgEntries, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                        <TextBlock Text="🌐" FontSize="13" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnAutoType_Click" ToolTip="{DynamicResource TbAutoType}"
                            IsEnabled="{Binding SelectedItem, ElementName=DgEntries, Converter={StaticResource CanAutoTypeConverter}}">
                        <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource ToolButton}" Click="BtnPasswordGenerator_Click" ToolTip="{DynamicResource TbGenerator}">
                        <TextBlock Text="⚡" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="MenuToggleTheme_Click" ToolTip="{DynamicResource MenuToggleTheme}">
                        <TextBlock Text="🌓" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="MenuSettings_Click" ToolTip="{DynamicResource TbSettings}">
                        <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnLock_Click" ToolTip="{DynamicResource TbLock}">
                        <TextBlock Text="🔒" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch" Padding="28,6,8,6" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" FontSize="11"/>
                    <TextBlock Text="{DynamicResource SearchPlaceholder}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="30,0,0,0"
                               IsHitTestVisible="False" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Groups Tree + Entries Grid + Details) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: GROUPS TREE (Distinct Tinted Sidebar) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Sidebar Header -->
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource FoldersAndGroups}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="➕" Click="BtnAddGroup_Click" ToolTip="{DynamicResource NewGroup}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource AccentColor}"/>
                        </Grid>
                    </Border>
                    <!-- Groups TreeView -->
                    <TreeView x:Name="TvGroups" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="TvGroups_SelectedItemChanged" Margin="4,6"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="TvGroups_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="TvGroups_PreviewMouseMove"
                              PreviewDragOver="TvGroups_PreviewDragOver"
                              DragLeave="TvGroups_DragLeave"
                              Drop="TvGroups_Drop"
                              ContextMenuOpening="TvGroups_ContextMenuOpening">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border x:Name="GroupRowBorder" CornerRadius="5" Padding="6,3" Margin="0,1" MinWidth="180" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource GroupIconConverter}}" Margin="0,0,7,0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="CmTreeGroups">
                                <MenuItem x:Name="CmAddEntry" Header="{DynamicResource MenuAddEntry}" Click="BtnAddEntry_Click"/>
                                <Separator x:Name="CmTreeSep1"/>
                                <MenuItem x:Name="CmAddSubgroup" Header="{DynamicResource AddSubgroup}" Click="BtnAddGroup_Click"/>
                                <MenuItem x:Name="CmRenameGroup" Header="{DynamicResource MenuRenameGroup}" Click="MenuRenameGroup_Click"/>
                                <MenuItem x:Name="CmDeleteGroup" Header="{DynamicResource MenuDeleteGroup}" Click="MenuDeleteGroup_Click"/>
                                <Separator x:Name="CmTreeSep2"/>
                                <MenuItem x:Name="CmMoveGroupUp" Header="{DynamicResource MenuMoveGroupUp}" Click="MenuMoveGroupUp_Click"/>
                                <MenuItem x:Name="CmMoveGroupDown" Header="{DynamicResource MenuMoveGroupDown}" Click="MenuMoveGroupDown_Click"/>
                                <MenuItem x:Name="CmMoveGroupToRoot" Header="{DynamicResource MenuMoveGroupToRoot}" Click="MenuMoveGroupToRoot_Click"/>
                                <Separator x:Name="CmTreeSep3"/>
                                <MenuItem x:Name="CmEmptyTrash" Header="{DynamicResource MenuEmptyTrash}" Click="MenuEmptyTrash_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>

            <!-- RIGHT: ENTRIES GRID + PREVIEW PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- ENTRIES DATAGRID (Alternating White & Soft Sky Tint) -->
                <DataGrid x:Name="DgEntries" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                          Background="{DynamicResource CardBg}"
                          RowBackground="{DynamicResource CardBg}"
                          AlternatingRowBackground="{DynamicResource RowAltBg}"
                          BorderThickness="0" RowHeight="32"
                          SelectionChanged="DgEntries_SelectionChanged"
                          MouseDoubleClick="DgEntries_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="DgEntries_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="DgEntries_PreviewMouseMove"
                          ContextMenuOpening="DgEntries_ContextMenuOpening">
                    <DataGrid.Columns>
                        <!-- Titolo with Lively Icon Badge -->
                        <DataGridTemplateColumn Header="{DynamicResource ColTitle}" Width="200" SortMemberPath="Title" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource IconBadgeBg}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource EntryIconConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- User Name -->
                        <DataGridTemplateColumn Header="{DynamicResource ColUserName}" Width="160" SortMemberPath="UserName" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="👤" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Password -->
                        <DataGridTextColumn x:Name="ColPassword" Header="{DynamicResource ColPassword}" Binding="{Binding Password, Converter={StaticResource PasswordMaskConverter}}" Width="140" FontFamily="Consolas" CanUserSort="True" SortMemberPath="Password"/>

                        <!-- URL -->
                        <DataGridTemplateColumn Header="{DynamicResource ColUrl}" Width="210" SortMemberPath="Url" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="🌐" Foreground="{DynamicResource AccentColor}" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Url}" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Notes -->
                        <DataGridTextColumn Header="{DynamicResource ColNotes}" Binding="{Binding Notes}" Width="*" CanUserSort="True" SortMemberPath="Notes"/>

                        <!-- Ultima Modifica -->
                        <DataGridTemplateColumn Header="{DynamicResource ColUpdatedAt}" Width="135" SortMemberPath="UpdatedAt" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="CmDataGrid">
                            <!-- Always available: Add New Entry -->
                            <MenuItem Header="{DynamicResource TbNewEntry}" Click="BtnAddEntry_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="{DynamicResource AccentColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="CmSep1"/>
                            <!-- Items enabled only when an entry is selected -->
                            <MenuItem x:Name="CmCopyUser" Header="{DynamicResource TbCopyUser}" Click="BtnCopyUsername_Click"/>
                            <MenuItem x:Name="CmCopyPassword" Header="{DynamicResource TbCopyPassword}" Click="BtnCopyPassword_Click"/>
                            <MenuItem x:Name="CmOpenUrl" Header="{DynamicResource TbOpenUrl}" Click="BtnOpenUrl_Click"/>
                            <MenuItem x:Name="CmAutoType" Header="{DynamicResource TbAutoType}" Click="BtnAutoType_Click"/>
                            <Separator x:Name="CmSep2"/>
                            <MenuItem x:Name="CmEdit" Header="{DynamicResource MenuEditEntry}" Click="BtnEditEntry_Click"/>
                            <MenuItem x:Name="CmDuplicate" Header="{DynamicResource MenuDuplicateEntry}" Click="BtnDuplicateEntry_Click"/>
                            <MenuItem x:Name="CmDelete" Header="{DynamicResource MenuDeleteEntry}" Click="BtnDeleteEntry_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderColor}"/>

                <!-- PREVIEW / DETAIL INSPECTOR -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="GridEntryPreview" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="340"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="PrevTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                                <!-- Username -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{DynamicResource PrevUser}" FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PrevUserName" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource Copy}" Click="BtnCopyUsername_Click" Margin="10,0,0,0"
                                            Style="{StaticResource PreviewSmallButton}"/>
                                </StackPanel>

                                <!-- Password with Reveal & Quality -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{DynamicResource PrevPassword}" FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PrevPassword" Text="••••••••" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="👁" Click="BtnPreviewTogglePassword_Click" Margin="8,0,4,0" Style="{StaticResource PreviewSmallButton}"/>
                                    <Button Content="{DynamicResource Copy}" Click="BtnCopyPassword_Click" Margin="4,0,0,0" Style="{StaticResource PreviewSmallButton}"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PrevEntropy}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="PrevPbQuality" Grid.Column="1" Height="6" Maximum="128"
                                                 Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                                    <TextBlock x:Name="PrevEntropyText" Grid.Column="2" Text="0 bits" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- URL -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource PrevUrl}" FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevUrl" Foreground="{DynamicResource AccentColor}" Cursor="Hand" TextDecorations="Underline" MouseDown="PrevUrl_MouseDown"/>
                                </StackPanel>

                                <!-- Modified & Tags -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource PrevModified}" FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevModified" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Notes Preview -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource PrevNotes}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" MinHeight="80">
                                    <TextBlock x:Name="PrevNotes" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="3" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusEntriesCount" Text="0" Foreground="{DynamicResource TextSecondary}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0" Background="{DynamicResource BorderColor}"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusClipboard" Text="" Foreground="#F59E0B" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0" Background="{DynamicResource BorderColor}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ " Foreground="#10B981"/>
                    <TextBlock x:Name="TxtStatusDb" Text="{DynamicResource VaultStatusDualBackup}" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
