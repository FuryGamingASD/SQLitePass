<Window x:Class="SQLitePass.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLitePass.UI.Converters"
        Title="SQLitePass" Height="720" Width="1080"
        Icon="/Resources/app_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:EntropyToColorConverter x:Key="EntropyToColorConverter"/>
        <conv:PasswordMaskConverter x:Key="PasswordMaskConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:GroupIconConverter x:Key="GroupIconConverter"/>
        <conv:EntryIconConverter x:Key="EntryIconConverter"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Standard Tool Button -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- TreeView Item Style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Source={DynamicResource TextPrimary}, Path=Color}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Source={DynamicResource TextPrimary}, Path=Color}"/>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENU BAR -->
        <Menu Grid.Row="0" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="6,3">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_Aggiungi Voce..." InputGestureText="Ctrl+I" Click="BtnAddEntry_Click"/>
                <MenuItem Header="_Aggiungi Gruppo..." InputGestureText="Ctrl+G" Click="BtnAddGroup_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Blocca Vault" InputGestureText="Ctrl+L" Click="BtnLock_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Importa CSV KeePass..." Click="MenuImportCsv_Click"/>
                <MenuItem Header="_Esporta CSV KeePass..." Click="MenuExportCsv_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Impostazioni..." Click="MenuSettings_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Esci" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Modifica">
                <MenuItem Header="_Modifica Voce" InputGestureText="Enter" Click="BtnEditEntry_Click"/>
                <MenuItem Header="_Duplica Voce" Click="BtnDuplicateEntry_Click"/>
                <MenuItem Header="_Elimina Voce" InputGestureText="Del" Click="BtnDeleteEntry_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="Rinomina Gruppo..." Click="MenuRenameGroup_Click"/>
                <MenuItem Header="Elimina Gruppo" Click="MenuDeleteGroup_Click"/>
            </MenuItem>
            <MenuItem Header="_Visualizza">
                <MenuItem Header="_Alterna Tema Chiaro / Scuro" Click="MenuToggleTheme_Click"/>
                <MenuItem Header="_Mostra/Nascondi Colonna Password" InputGestureText="Ctrl+H" Click="MenuTogglePasswords_Click"/>
                <MenuItem Header="_Aggiorna" InputGestureText="F5" Click="MenuRefresh_Click"/>
            </MenuItem>
            <MenuItem Header="_Strumenti">
                <MenuItem Header="_Generatore Password..." InputGestureText="Ctrl+W" Click="BtnPasswordGenerator_Click"/>
                <MenuItem Header="_Auto-Type Voce Selezionata" InputGestureText="Ctrl+V" Click="BtnAutoType_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Cancella Appunti Subito" Click="BtnClearClipboard_Click"/>
            </MenuItem>
            <MenuItem Header="_Aiuto">
                <MenuItem Header="_Verifica Aggiornamenti..." Click="MenuCheckUpdates_Click"/>
                <Separator Background="{DynamicResource BorderColor}"/>
                <MenuItem Header="_Informazioni su SQLitePass" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <!-- Prominent New Entry Button -->
                    <Button Style="{StaticResource PrimaryToolButton}" Click="BtnAddEntry_Click" ToolTip="Aggiungi Nuova Voce (Ctrl+I)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuova Voce" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Click="BtnEditEntry_Click" ToolTip="Modifica Voce Selezionata">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Margin="0,0,5,0"/>
                            <TextBlock Text="Modifica"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnDeleteEntry_Click" ToolTip="Elimina Voce Selezionata">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,5,0" Foreground="#EF4444"/>
                            <TextBlock Text="Elimina"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2" Background="{DynamicResource BorderColor}"/>

                    <Button Style="{StaticResource ToolButton}" Click="BtnCopyUsername_Click" ToolTip="Copia Nome Utente (doppio click colonna)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,5,0"/>
                            <TextBlock Text="Copia User"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnCopyPassword_Click" ToolTip="Copia Password (doppio click colonna, cancella in 12s)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" Margin="0,0,5,0" Foreground="#F59E0B"/>
                            <TextBlock Text="Copia Password"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnOpenUrl_Click" ToolTip="Apri URL nel Browser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,5,0" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="Apri URL"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnAutoType_Click" ToolTip="Esegui Auto-Type (Ctrl+V)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️" Margin="0,0,5,0"/>
                            <TextBlock Text="Auto-Type"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2" Background="{DynamicResource BorderColor}"/>

                    <Button Style="{StaticResource ToolButton}" Click="BtnPasswordGenerator_Click" ToolTip="Generatore di Password Sicure">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,5,0" Foreground="#F59E0B"/>
                            <TextBlock Text="Generatore"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="MenuToggleTheme_Click" ToolTip="Alterna Tema Chiaro / Scuro">
                        <TextBlock Text="🌓" Margin="0,0,0,0" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="MenuSettings_Click" ToolTip="Impostazioni">
                        <TextBlock Text="⚙️" Margin="0,0,0,0"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="BtnLock_Click" ToolTip="Blocca il Vault (Ctrl+L)">
                        <TextBlock Text="🔒" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Column="2">
                    <TextBox x:Name="TxtSearch" Padding="28,6,8,6" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Cerca nelle voci..." Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="30,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Groups Tree + Entries Grid + Details) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: GROUPS TREE (Distinct Tinted Sidebar) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Sidebar Header -->
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cartelle e Gruppi" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="➕" Click="BtnAddGroup_Click" ToolTip="Nuovo Gruppo"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource AccentColor}"/>
                        </Grid>
                    </Border>
                    <!-- Groups TreeView -->
                    <TreeView x:Name="TvGroups" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="TvGroups_SelectedItemChanged" Margin="4,6">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="3,4">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource GroupIconConverter}}" Margin="0,0,7,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Aggiungi Sottogruppo..." Click="BtnAddGroup_Click"/>
                                <MenuItem Header="Rinomina Gruppo..." Click="MenuRenameGroup_Click"/>
                                <MenuItem Header="Elimina Gruppo" Click="MenuDeleteGroup_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>

            <!-- RIGHT: ENTRIES GRID + PREVIEW PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- ENTRIES DATAGRID (Alternating White & Soft Sky Tint) -->
                <DataGrid x:Name="DgEntries" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                          Background="{DynamicResource CardBg}"
                          RowBackground="{DynamicResource CardBg}"
                          AlternatingRowBackground="{DynamicResource RowAltBg}"
                          BorderThickness="0" RowHeight="32"
                          SelectionChanged="DgEntries_SelectionChanged"
                          MouseDoubleClick="DgEntries_MouseDoubleClick">
                    <DataGrid.Columns>
                        <!-- Titolo with Lively Icon Badge -->
                        <DataGridTemplateColumn Header="Titolo" Width="200" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource IconBadgeBg}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource EntryIconConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- User Name -->
                        <DataGridTemplateColumn Header="User Name" Width="160" SortMemberPath="UserName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="👤" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Password -->
                        <DataGridTextColumn x:Name="ColPassword" Header="Password" Binding="{Binding Password, Converter={StaticResource PasswordMaskConverter}}" Width="140" FontFamily="Consolas"/>

                        <!-- URL -->
                        <DataGridTemplateColumn Header="URL" Width="210" SortMemberPath="Url">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="🌐" Foreground="{DynamicResource AccentColor}" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Url}" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Notes -->
                        <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*"/>

                        <!-- Ultima Modifica -->
                        <DataGridTemplateColumn Header="Ultima Modifica" Width="135" SortMemberPath="UpdatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copia Nome Utente" Click="BtnCopyUsername_Click"/>
                            <MenuItem Header="Copia Password" Click="BtnCopyPassword_Click"/>
                            <MenuItem Header="Apri URL" Click="BtnOpenUrl_Click"/>
                            <MenuItem Header="Esegui Auto-Type" Click="BtnAutoType_Click"/>
                            <Separator/>
                            <MenuItem Header="Modifica Voce..." Click="BtnEditEntry_Click"/>
                            <MenuItem Header="Duplica Voce" Click="BtnDuplicateEntry_Click"/>
                            <MenuItem Header="Elimina Voce" Click="BtnDeleteEntry_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderColor}"/>

                <!-- PREVIEW / DETAIL INSPECTOR -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="GridEntryPreview" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="340"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="PrevTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                                <!-- Username -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Utente: " FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevUserName" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Content="Copia" Click="BtnCopyUsername_Click" Margin="10,0,0,0" Padding="6,2"
                                            Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Password with Reveal & Quality -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Password: " FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevPassword" Text="••••••••" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Content="👁" Click="BtnPreviewTogglePassword_Click" Margin="8,0,4,0" Padding="5,1" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="Copia" Click="BtnCopyPassword_Click" Margin="4,0,0,0" Padding="6,2"
                                            Background="{DynamicResource HoverBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Entropia:" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="PrevPbQuality" Grid.Column="1" Height="6" Maximum="128"
                                                 Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource EntropyToColorConverter}}"/>
                                    <TextBlock x:Name="PrevEntropyText" Grid.Column="2" Text="0 bits" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- URL -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="URL: " FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevUrl" Foreground="{DynamicResource AccentColor}" Cursor="Hand" TextDecorations="Underline" MouseDown="PrevUrl_MouseDown"/>
                                </StackPanel>

                                <!-- Modified & Tags -->
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Modificato: " FontWeight="SemiBold" Width="80" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="PrevModified" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Notes Preview -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Note:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" MinHeight="80">
                                    <TextBlock x:Name="PrevNotes" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="3" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusEntriesCount" Text="0 voci" Foreground="{DynamicResource TextSecondary}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0" Background="{DynamicResource BorderColor}"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusClipboard" Text="" Foreground="#F59E0B" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0" Background="{DynamicResource BorderColor}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ " Foreground="#10B981"/>
                    <TextBlock x:Name="TxtStatusDb" Text="Vault SQLite (.kpd) • Dual Backup Attivo" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
