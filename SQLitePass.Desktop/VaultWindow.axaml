<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:SQLitePass.Desktop"
        x:Class="SQLitePass.Desktop.VaultWindow"
        Title="SQLitePass" Icon="avares://SQLitePass.Desktop/Resources/app.ico"
        WindowStartupLocation="CenterScreen" Width="960" Height="640" MinWidth="580" MinHeight="480">
    <Grid RowDefinitions="*,Auto" Margin="24">
        <ScrollViewer x:Name="UnlockPanel" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <StackPanel Width="450" Spacing="12" Margin="12">
                <TextBlock Text="SQLitePass" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="VaultPathLabel" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="VaultPath" AutomationProperties.LabeledBy="{Binding #VaultPathLabel}" />
                    <Button x:Name="BrowseVault" Grid.Column="1" Click="BrowseVault_Click" />
                </Grid>
                <TextBlock x:Name="PasswordLabel" />
                <TextBox x:Name="MasterPassword" PasswordChar="●" IsUndoEnabled="False"
                         AutomationProperties.LabeledBy="{Binding #PasswordLabel}" />
                <TextBlock x:Name="KeyFileLabel" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="KeyFilePath" AutomationProperties.LabeledBy="{Binding #KeyFileLabel}" />
                    <Button x:Name="BrowseKeyFile" Grid.Column="1" Click="BrowseKeyFile_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button x:Name="Unlock" Classes="accent" IsDefault="True" Click="Unlock_Click" />
                    <Button x:Name="NewVault" Click="NewVault_Click" />
                </StackPanel>
                <Button x:Name="RestoreBackup" Click="RestoreBackup_Click" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="VaultPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="VaultName" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Menu x:Name="VaultMenu" Grid.Column="1" VerticalAlignment="Center">
                    <MenuItem x:Name="FileMenu">
                        <MenuItem x:Name="ChangeCredential" Click="ChangeCredential_Click" />
                        <Separator />
                        <MenuItem x:Name="ImportKeePass" Click="ImportKeePass_Click" />
                        <MenuItem x:Name="ImportBitwarden" Click="ImportBitwarden_Click" />
                        <MenuItem x:Name="ImportBrowser" Click="ImportBrowser_Click" />
                        <MenuItem x:Name="ExportKeePass" Click="ExportKeePass_Click" />
                        <Separator />
                        <MenuItem x:Name="ClearClipboard" Click="ClearClipboard_Click" />
                        <MenuItem x:Name="ExitApplication" Click="ExitApplication_Click" />
                    </MenuItem>
                </Menu>
                <Button x:Name="LockVault" Grid.Column="2" Click="LockVault_Click" />
            </Grid>
            <StackPanel x:Name="QueryPanel" Grid.Row="1" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" MaxLength="4096" />
                    <Button x:Name="Search" Grid.Column="1" Click="Search_Click" />
                </Grid>
                <WrapPanel>
                    <ComboBox x:Name="ExpiryFilter" Margin="0,0,8,4" SelectionChanged="BrowseOption_Changed" />
                    <TextBox x:Name="TagFilter" MinWidth="115" MaxLength="256" Margin="0,0,8,4" KeyDown="SearchBox_KeyDown" />
                    <ComboBox x:Name="SortField" Margin="0,0,8,4" SelectionChanged="BrowseOption_Changed" />
                    <ToggleButton x:Name="SortDescending" Margin="0,0,8,4" Click="BrowseSort_Click" />
                    <Button x:Name="ResetFilters" Margin="0,0,8,4" Click="ResetFilters_Click" />
                </WrapPanel>
            </StackPanel>
            <Grid x:Name="GroupPanel" Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <ComboBox x:Name="Groups" HorizontalAlignment="Stretch" SelectionChanged="Group_SelectionChanged" />
                <Button x:Name="AddEntry" Grid.Column="1" Click="AddEntry_Click" />
                <Button x:Name="EditEntry" Grid.Column="2" Click="EditEntry_Click" IsEnabled="False" />
                <Menu Grid.Column="3" VerticalAlignment="Center">
                    <MenuItem x:Name="FolderMenu">
                        <MenuItem x:Name="CreateFolder" Click="CreateFolder_Click" />
                        <MenuItem x:Name="RenameFolder" Click="RenameFolder_Click" />
                        <MenuItem x:Name="MoveFolder" Click="MoveFolder_Click" />
                        <MenuItem x:Name="MoveFolderUp" Click="MoveFolderUp_Click" />
                        <MenuItem x:Name="MoveFolderDown" Click="MoveFolderDown_Click" />
                        <Separator />
                        <MenuItem x:Name="DeleteFolder" Click="DeleteFolder_Click" />
                    </MenuItem>
                    <MenuItem x:Name="EntryMenu">
                        <MenuItem x:Name="CopyUser" Click="CopyUser_Click" />
                        <MenuItem x:Name="CopyPassword" Click="CopyPassword_Click" />
                        <MenuItem x:Name="AutoTypeEntry" Click="AutoTypeEntry_Click" />
                        <Separator />
                        <MenuItem x:Name="DuplicateEntry" Click="DuplicateEntry_Click" />
                        <MenuItem x:Name="MoveEntryCommand" Click="MoveEntry_Click" />
                        <MenuItem x:Name="DeleteEntry" Click="DeleteEntry_Click" />
                        <MenuItem x:Name="RestoreEntry" Click="RestoreEntry_Click" />
                        <Separator />
                        <MenuItem x:Name="EmptyRecycleBin" Click="EmptyRecycleBin_Click" />
                    </MenuItem>
                </Menu>
            </Grid>
            <ListBox x:Name="Entries" Grid.Row="3" SelectionChanged="Entries_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="desktop:EntryRow">
                        <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="16">
                            <TextBlock Text="{CompiledBinding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{CompiledBinding UserName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{CompiledBinding Url}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="PagePanel" Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="EntryCount" />
                    <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="PreviousPage" Grid.Column="1" Click="PreviousPage_Click" />
                <Button x:Name="NextPage" Grid.Column="2" Click="NextPage_Click" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="CancelOperation" Grid.Column="1" IsVisible="False" Click="CancelOperation_Click" />
        </Grid>
    </Grid>
</Window>
