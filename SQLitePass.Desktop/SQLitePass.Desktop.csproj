<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
    <CsWinRTWindowsMetadata>local</CsWinRTWindowsMetadata>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ApplicationIcon>../SQLitePass.UI/Resources/app.ico</ApplicationIcon>
    <UpdateSigningPublicKeyBase64 Condition="'$(UpdateSigningPublicKeyBase64)' == ''">$(UPDATE_SIGNING_PUBLIC_KEY)</UpdateSigningPublicKeyBase64>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CsWinRTEnabled>false</CsWinRTEnabled>
    <CsWinRTIIDOptimizerOptOut>true</CsWinRTIIDOptimizerOptOut>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SQLitePass.Tests" />
    <ProjectReference Include="../SQLitePass.Core/SQLitePass.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="11.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Compile Include="../SQLitePass.UI/Services/TranslationCatalog.cs" Link="Localization/TranslationCatalog.cs" />
    <Compile Include="../SQLitePass.UI/Services/SingleInstanceCoordinator.cs" Link="Services/WindowsSingleInstanceCoordinator.cs" />
    <EmbeddedResource Include="../SQLitePass.UI/Localization/*.json" LogicalName="SQLitePass.Localization.%(Filename)%(Extension)" WithCulture="false" />
    <AvaloniaResource Include="../SQLitePass.UI/Resources/app.ico" Link="Resources/app.ico" />
    <AvaloniaResource Include="../SQLitePass.UI/Resources/app_icon.png" Link="Resources/app_icon.png" />
    <Compile Include="../SQLitePass.UI/Controls/AppIconPaths.cs" Link="Controls/AppIconPaths.cs" />
    <Compile Include="../SQLitePass.UI/Controls/AppIconLabels.cs" Link="Controls/AppIconLabels.cs" />
    <Content Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SECURITY.md" Link="SECURITY.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The public key is compiled into the client as its update-authentication pin. -->
    <AssemblyMetadata Include="SQLitePass.UpdateSigningPublicKey" Value="$(UpdateSigningPublicKeyBase64)" />
  </ItemGroup>
</Project>
