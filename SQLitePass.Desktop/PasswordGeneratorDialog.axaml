<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SQLitePass.Desktop.PasswordGeneratorDialog"
        Width="510" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="ResultLabel" />
        <Border Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="4">
            <TextBlock x:Name="Result" TextWrapping="Wrap" FontFamily="monospace" />
        </Border>
        <TextBlock x:Name="Quality" />
        <ProgressBar x:Name="QualityBar" Maximum="100" AutomationProperties.LabeledBy="{Binding #Quality}" />
        <StackPanel Spacing="4" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="LengthLabel" VerticalAlignment="Center" />
            <NumericUpDown x:Name="Length" Minimum="6" Maximum="64" Value="20" Increment="1"
                           FormatString="0" Width="100" ValueChanged="Options_Changed"
                           AutomationProperties.LabeledBy="{Binding #LengthLabel}" />
        </StackPanel>
        <CheckBox x:Name="Upper" IsChecked="True" IsCheckedChanged="Options_Changed" />
        <CheckBox x:Name="Lower" IsChecked="True" IsCheckedChanged="Options_Changed" />
        <CheckBox x:Name="Digits" IsChecked="True" IsCheckedChanged="Options_Changed" />
        <CheckBox x:Name="Symbols" IsChecked="True" IsCheckedChanged="Options_Changed" />
        <CheckBox x:Name="Brackets" IsCheckedChanged="Options_Changed" />
        <CheckBox x:Name="ExcludeAmbiguous" IsChecked="True" IsCheckedChanged="Options_Changed" />
        <WrapPanel>
            <Button x:Name="Regenerate" Margin="0,0,8,6" Click="Options_Changed" />
            <Button x:Name="CopyPassword" Margin="0,0,8,6" Click="Copy_Click" />
            <Button x:Name="UsePassword" Margin="0,0,8,6" Classes="accent" Click="Use_Click" />
            <Button x:Name="Dismiss" Margin="0,0,0,6" IsCancel="True" Click="Dismiss_Click" />
        </WrapPanel>
        <TextBlock x:Name="ClipboardStatus" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
</Window>
