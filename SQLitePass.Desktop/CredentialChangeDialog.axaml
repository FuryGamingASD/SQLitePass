<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SQLitePass.Desktop.CredentialChangeDialog"
        Width="540" Height="580" MinWidth="420" MinHeight="375" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" RowSpacing="12" Margin="20">
        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock x:Name="CurrentPasswordLabel" />
                <TextBox x:Name="CurrentPassword" IsUndoEnabled="False" PasswordChar="●"
                         AutomationProperties.LabeledBy="{Binding #CurrentPasswordLabel}" />
                <TextBlock x:Name="CurrentFileLabel" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="CurrentFile" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #CurrentFileLabel}" />
                    <Button x:Name="BrowseCurrent" Grid.Column="1" Click="BrowseCurrent_Click" />
                </Grid>
                <Separator Margin="0,4" />
                <TextBlock x:Name="ReplacementLabel" />
                <TextBox x:Name="ReplacementPassword" IsUndoEnabled="False" PasswordChar="●"
                         AutomationProperties.LabeledBy="{Binding #ReplacementLabel}" />
                <TextBlock x:Name="ConfirmationLabel" />
                <TextBox x:Name="ConfirmationPassword" IsUndoEnabled="False" PasswordChar="●"
                         AutomationProperties.LabeledBy="{Binding #ConfirmationLabel}" />
                <TextBlock x:Name="ReplacementFileLabel" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ReplacementFile" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #ReplacementFileLabel}" />
                    <Button x:Name="BrowseReplacement" Grid.Column="1" Click="BrowseReplacement_Click" />
                </Grid>
                <TextBlock x:Name="BackupInfo" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelAction" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="SaveAction" Classes="accent" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
