<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:SQLitePass.Core.Models"
        x:Class="SQLitePass.Desktop.EntryEditor"
        Background="{DynamicResource WorkspaceCanvas}" Foreground="{DynamicResource WorkspaceText}"
        Width="640" Height="590" MinWidth="500" MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TabItem.editor-tab">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="ToolTip.Tip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="HeaderTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8" Margin="18">
        <TabControl x:Name="Sections" Padding="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid ColumnDefinitions="1.1*,1.65*,1.05*,.8*,1.25*" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabItem x:Name="CredentialsTab" Classes="editor-tab">
                <ScrollViewer x:Name="CredentialsScroll" AllowAutoHide="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,2">
                    <StackPanel Spacing="7">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TitleLabel" />
                            <TextBox x:Name="EntryTitle" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #TitleLabel}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="UserLabel" />
                            <TextBox x:Name="UserName" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #UserLabel}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="PasswordLabel" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="Password" PasswordChar="●" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #PasswordLabel}" />
                                <Button x:Name="RevealPassword" Grid.Column="1" Click="RevealPassword_Click" />
                                <Button x:Name="GeneratePassword" Grid.Column="2" Click="GeneratePassword_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="UrlLabel" />
                            <TextBox x:Name="Url" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #UrlLabel}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TagsLabel" />
                            <TextBox x:Name="Tags" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #TagsLabel}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="NotesLabel" />
                            <TextBox x:Name="Notes" Height="68" AcceptsReturn="True" TextWrapping="Wrap" IsUndoEnabled="False"
                                     ScrollViewer.AllowAutoHide="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.LabeledBy="{Binding #NotesLabel}" />
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="EnableExpiry" Margin="0,0,10,0" IsCheckedChanged="EnableExpiry_Changed" />
                            <DatePicker x:Name="Expiry" AutomationProperties.LabeledBy="{Binding #EnableExpiry}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CustomFieldsTab" Grid.Column="1" Classes="editor-tab">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <ListBox x:Name="CustomFields" SelectionChanged="CustomFields_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:PwCustomField">
                                <TextBlock Text="{CompiledBinding Key}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Spacing="7">
                        <TextBlock x:Name="FieldNameLabel" />
                        <TextBox x:Name="FieldName" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #FieldNameLabel}" />
                        <TextBlock x:Name="FieldValueLabel" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FieldValue" PasswordChar="●" IsUndoEnabled="False" AutomationProperties.LabeledBy="{Binding #FieldValueLabel}" />
                            <Button x:Name="RevealField" Grid.Column="1" Click="RevealField_Click" />
                        </Grid>
                        <CheckBox x:Name="FieldProtected" IsChecked="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddField" Click="AddField_Click" />
                            <Button x:Name="SaveField" Click="SaveField_Click" />
                            <Button x:Name="RemoveField" Click="RemoveField_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="AttachmentsTab" Grid.Column="2" Classes="editor-tab">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <ListBox x:Name="Attachments" SelectionChanged="Attachments_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:PwAttachment">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="4,3">
                                    <TextBlock Text="{CompiledBinding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{CompiledBinding FileSize, StringFormat='{}{0:N0} B'}"
                                               Foreground="{DynamicResource WorkspaceMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddAttachment" Click="AddAttachment_Click" />
                        <Button x:Name="SaveAttachment" Click="SaveAttachment_Click" IsEnabled="False" />
                        <Button x:Name="RemoveAttachment" Click="RemoveAttachment_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="HistoryTab" Grid.Column="3" Classes="editor-tab">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <ListBox x:Name="History" SelectionChanged="History_SelectionChanged" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RestoreHistory" Click="RestoreHistory_Click" IsEnabled="False" />
                        <Button x:Name="ClearHistory" Click="ClearHistory_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="AutoTypeTab" Grid.Column="4" Classes="editor-tab">
                <StackPanel Spacing="8" Margin="0,10,0,0">
                    <CheckBox x:Name="AutoTypeEnabled" />
                    <TextBlock x:Name="SequenceLabel" />
                    <TextBox x:Name="Sequence" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                             AutomationProperties.LabeledBy="{Binding #SequenceLabel}" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="ValidationMessage" Grid.Row="1" IsVisible="False" TextWrapping="Wrap" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="EditedIndicator" IsVisible="False" VerticalAlignment="Center"
                       Foreground="{DynamicResource WorkspaceMuted}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="Cancel" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="Save" Classes="accent" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
